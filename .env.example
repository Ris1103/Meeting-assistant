# =============================================================================
# Meeting Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM (Anthropic Claude)
# Required for AI-powered responses
# Get yours at: https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Speech Recognition (Whisper)
# Model size controls speed vs accuracy trade-off:
#   tiny (fastest, lowest accuracy) → base → small → medium → large-v3 (best)
# -----------------------------------------------------------------------------
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu                   # cpu | cuda | mps (Apple Silicon)
WHISPER_COMPUTE_TYPE=int8            # int8 (fast) | float16 | float32

# HuggingFace token — required only for speaker diarization (pyannote models)
# Get yours at: https://huggingface.co/settings/tokens
# You must also accept pyannote model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# -----------------------------------------------------------------------------
# Zoom Integration
# Create an OAuth app at: https://marketplace.zoom.us/develop/create
# Scopes needed: meeting:read:list_past_participants, chat_message:read
# -----------------------------------------------------------------------------
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8080/callback

# -----------------------------------------------------------------------------
# Microsoft Teams Integration
# Register an app at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Delegated permissions needed: Chat.Read, OnlineMeetings.Read
# -----------------------------------------------------------------------------
TEAMS_CLIENT_ID=
TEAMS_TENANT_ID=common              # Your tenant ID or "common" for multi-tenant

# -----------------------------------------------------------------------------
# Google Meet Integration
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# Scopes needed: https://www.googleapis.com/auth/meetings.space.readonly
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/callback

# -----------------------------------------------------------------------------
# Audio Configuration
# -----------------------------------------------------------------------------
# Name of the loopback audio device for capturing meeting audio.
# Leave blank for auto-detection.
#   macOS: Install BlackHole (https://github.com/ExistentialAudio/BlackHole)
#          then set: BlackHole 2ch
#   Windows: Auto-detected via WASAPI loopback
#   Linux: Auto-detected via PulseAudio/PipeWire monitor source
LOOPBACK_DEVICE_NAME=

# Index of microphone device (leave blank to use system default)
MIC_DEVICE_INDEX=

# Sample rate for audio capture (Hz). 16000 is optimal for Whisper.
AUDIO_SAMPLE_RATE=16000

# Size of audio chunks to process (milliseconds). Must be 10, 20, or 30.
VAD_FRAME_DURATION_MS=30

# VAD aggressiveness: 0 (least aggressive) to 3 (most aggressive)
# Higher = more silence filtered out
VAD_AGGRESSIVENESS=2

# Duration of audio buffer to accumulate before running transcription (seconds)
TRANSCRIPTION_BUFFER_SECONDS=5

# -----------------------------------------------------------------------------
# Pipeline Behaviour
# -----------------------------------------------------------------------------
# Keyword that triggers the assistant to respond (case-insensitive)
TRIGGER_KEYWORD=assistant

# Primary language for speech recognition (BCP-47 code, e.g. en, fr, de, es)
LANGUAGE=en

# Maximum number of concurrent speakers to track
MAX_SPEAKERS=8

# How the assistant delivers responses:
#   local_playback — speak through your headphones/speakers (private)
#   chat_message   — post answer to meeting chat (visible to all)
RESPONSE_MODE=local_playback

# TTS voice for edge-tts (run `edge-tts --list-voices` to see all options)
TTS_VOICE=en-US-JennyNeural

# -----------------------------------------------------------------------------
# Privacy & Storage
# -----------------------------------------------------------------------------
# Set to true to disable all transcript logging (in-memory only)
NO_STORE=false

# Directory to save session transcripts (only used when NO_STORE=false)
TRANSCRIPT_DIR=./transcripts
